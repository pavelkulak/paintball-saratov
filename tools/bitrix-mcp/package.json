{
  "name": "paintball-bitrix-mcp-runtime",
  "private": true,
  "description": "Local read-only Bitrix MCP runtime for the Paintball project",
  "scripts": {
    "mcp": "node_modules/node/bin/node --experimental-sqlite node_modules/@mb4it/bitrix-mcp/dist/cli.js serve",
    "status": "node_modules/node/bin/node --experimental-sqlite node_modules/@mb4it/bitrix-mcp/dist/cli.js status",
    "config": "node_modules/node/bin/node --experimental-sqlite node_modules/@mb4it/bitrix-mcp/dist/cli.js config",
    "doctor": "node_modules/node/bin/node --experimental-sqlite node_modules/@mb4it/bitrix-mcp/dist/cli.js doctor --verbose",
    "index": "node_modules/node/bin/node --experimental-sqlite node_modules/@mb4it/bitrix-mcp/dist/cli.js index-all"
  },
  "dependencies": {
    "@mb4it/bitrix-mcp": "0.6.0"
  },
  "devDependencies": {
    "node": "^22.22.3"
  }
}
