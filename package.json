{
  "name": "paintball-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.22.3",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "setup": "npm ci && node tools/scripts/ensure-node.mjs && npm --prefix tools/bitrix-mcp ci",
    "dev": "next dev",
    "build": "next build",
    "start": "npm run preview",
    "preview": "node tools/scripts/preview.mjs",
    "bitrix:up": "node tools/scripts/bitrix-compose.mjs up -d",
    "bitrix:down": "node tools/scripts/bitrix-compose.mjs down",
    "bitrix:status": "node tools/scripts/bitrix-compose.mjs ps",
    "bitrix:snapshot": "node tools/scripts/bitrix-snapshot.mjs",
    "mcp:serve": "node tools/bitrix-mcp/run.mjs serve",
    "mcp:status": "node tools/bitrix-mcp/run.mjs status",
    "mcp:config": "node tools/bitrix-mcp/run.mjs config",
    "mcp:doctor": "node tools/bitrix-mcp/run.mjs doctor --verbose",
    "mcp:index": "node tools/bitrix-mcp/run.mjs index-all --no-progress",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run build",
    "verify": "node tools/scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
