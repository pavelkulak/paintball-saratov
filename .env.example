# Full endpoint URL used only during `next build`.
BITRIX_API_URL=http://paintball-bitrix.local/api/v1/home

# Set to `demo` only for standalone preview builds without Bitrix.
# CONTENT_SOURCE=demo

# MCP reads the live OSPanel installation, not a copied snapshot.
BITRIX_ROOT=./cms
BITRIX_MCP_WORKSPACE=.
BITRIX_MCP_DATA_DIR=./.bitrix-mcp
# Set this to the selected OSPanel PHP CLI executable.
BITRIX_MCP_PHP_BIN=D:\OSPanel\modules\PHP-8.2\php.exe
BITRIX_MCP_DB_ENABLED=1
BITRIX_MCP_DB_ALLOW_WRITE=0
BITRIX_MCP_TINKER_ENABLED=1
